# Copy to .env and fill in your own values. Never commit .env.

# Azure context
AZ_SUBSCRIPTION_ID=<your-subscription-id>
AZ_TENANT_ID=<your-tenant-id>
LOCATION=<your-region>

# Existing WS1 App Service plan (Workflow Standard) to host the Logic App
PLAN_NAME=<your-ws1-plan-name>
PLAN_RESOURCE_GROUP=<your-plan-resource-group>

# New resources for this project (created in the plan's resource group)
RESOURCE_GROUP=<your-resource-group>
STORAGE_ACCOUNT=<your-storage-account-name>
LOGIC_APP_NAME=<your-logic-app-name>
LOGIC_APP_PRINCIPAL_ID=<your-logic-app-managed-identity-object-id>

# Microsoft Foundry resource with a Microsoft-Decision-1 deployment
FOUNDRY_RESOURCE_GROUP=<your-foundry-resource-group>
FOUNDRY_RESOURCE_NAME=<your-foundry-resource-name>
FOUNDRY_ENDPOINT=<your-foundry-endpoint>
DECISION_DEPLOYMENT_NAME=<your-decision-deployment-name>

# Optional, used by scan.sh: extra identifiers that must never appear in the repo,
# as an extended regex (for example your name or other resource names): name1|name2
SCAN_EXTRA_PATTERNS=
